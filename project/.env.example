# Alpha Studio - Environment Variables
# Copy this file to .env and fill in your API keys

# Hugging Face API Key (Required for image generation with Animagine XL 3.1)
# Get your key at: https://huggingface.co/settings/tokens
VITE_HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Groq API Key (Required for AI prompt enhancement with Llama 3.1 70B - FREE)
# Get your key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Replicate API Key (Optional for video generation with Luma, Kling, Runway)
# Get your key at: https://replicate.com/account/api-tokens
VITE_REPLICATE_API_TOKEN=your_replicate_api_token_here

# OpenAI API Key (Optional for GPT-4o story generation)
# Get your key at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key (Optional for voice-over in anime movies)
# Get your key at: https://elevenlabs.io/app/settings/api-keys
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Supabase Configuration (Optional for cloud storage)
# Get your credentials at: https://supabase.com/dashboard
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
